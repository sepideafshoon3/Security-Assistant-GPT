# Example environment config
APP_PORT=8000

# development|dev|local = relaxed local-dev behavior (insecure default JWT
# secret allowed, CORS_ORIGINS optional). Anything else (e.g. production,
# staging) is treated as a real deployment: JWT_SECRET_KEY and CORS_ORIGINS
# become required, and the app refuses to start without them.
APP_ENV=development

# Comma-separated list of allowed frontend origins, e.g.
# https://app.example.com,https://admin.example.com
# Required once APP_ENV is not development/dev/local. Unset in local dev
# falls back to the usual Vite ports (3000/5173/5174, localhost + 127.0.0.1).
# CORS_ORIGINS=

# Redirect http->https in this process. Leave unset on Railway/Render/Fly/etc
# - they terminate TLS and redirect at the edge already, and this can loop
# if a proxy in front doesn't forward X-Forwarded-Proto. Only for a bare VM
# with no such proxy.
# FORCE_HTTPS=0

# Secret for signing JWT session tokens. Required once APP_ENV is not
# development/dev/local. Generate with: openssl rand -hex 32
# JWT_SECRET_KEY=

# Audit log location
AUDIT_LOG_PATH=logs/actions-audit.log

# Lab-only network scopes (enforced via config files too)
LAB_SCOPE_CONFIG=config/policies/lab-scopes.yaml

# /exploit/* (LLM-generated exploit code + run instructions). Off by default
# and NOT gated by PolicyEngine yet -- see DEPLOY.md before ever setting
# this to 1 outside a local/lab environment.
ENABLE_EXPLOIT_ROUTER=0
OPENAI_API_KEY="xxxxxxxxxxxxxxxxxxx"
OPENAI_ORG_ID="xxxxxxxxxxxxxxxxxxx"
OPENAI_BASE_URL="xxxxxxxxxxxxxxxxxxx"
# LLM models (read by entire api-core; override without code changes)
OPENAI_DEFAULT_CHAT_MODEL=gpt-5.6-luna
LLM_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_ENABLE_WEB_SEARCH=0
LLM_LOCAL_WEB_SEARCH=0
# ONLINE_LEARNING_ENDPOINT=http://127.0.0.1:2121
# ONLINE_LEARNING_API_KEY=
MRROBOT_PROMPT_MODE=multi
LOG_LEVEL=DEBUG
# LOG_FORMAT=text|json. text is easier to read in a terminal (default);
# switch to json once logs are going to an aggregator (Week 6 deploy).
# LOG_FORMAT=text

# Error monitoring (Sentry). Unset = disabled entirely, no-op.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# Fraction of requests to trace for performance data, not just errors (0-1).
# SENTRY_TRACES_SAMPLE_RATE=0

# Rate limits (slowapi syntax, e.g. "5/minute", "100/hour"). In-memory,
# per-process — see src/security/rate_limit.py if this ever runs as more
# than one worker/instance.
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_SIGNUP=5/minute
# RATE_LIMIT_CHAT=20/minute
# RATE_LIMIT_WRITE=30/minute
# RATE_LIMIT_ONLINE_LEARNING=60/minute
# RATE_LIMIT_DATASET_BUILD=5/minute

# Database. Defaults to a local SQLite file (data/app.db). For Postgres use e.g.
# postgresql+psycopg://user:pass@host:5432/dbname (requires `pip install ".[postgres]"`).
# A docker-compose.yml at the repo root brings up a local Postgres for testing;
# see api-core/scripts/check_db.sh to verify DATABASE_URL actually works.
# DATABASE_URL=
# Connection pool size for non-SQLite databases (ignored for SQLite).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# Schema is managed by Alembic. By default the API runs `alembic upgrade head` on
# startup; set to 0 to skip that and run it yourself as a deploy step.
# DB_AUTO_MIGRATE=1
